{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "onboarding:status": "python3 onboarding_server.py --status",
    "onboarding:server": "python3 onboarding_server.py",
    "isolation:verify": "python3 app.py --verify-isolation",
    "isolation:server": "python3 app.py",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@netlify/blobs": "^11.1.4",
    "@supabase/server": "^1.9.1",
